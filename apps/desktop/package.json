{
  "name": "recall-app",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.node.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:engine": "cd ../.. && venv\\Scripts\\python.exe -m PyInstaller apps/api/recall-engine.spec --noconfirm --distpath apps/api/dist --workpath apps/api/build",
    "package:app-dir": "npm run build && electron-builder --win dir",
    "package:full": "npm run package:engine && npm run package:app-dir",
    "package:full:dir": "npm run package:full",
    "package:zip": "powershell -ExecutionPolicy Bypass -File ../../scripts/package_portable.ps1",
    "package:zip:reuse-engine": "powershell -ExecutionPolicy Bypass -File ../../scripts/package_portable.ps1 -SkipEngine",
    "package:installer": "powershell -ExecutionPolicy Bypass -File ../../scripts/package_installed.ps1"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@hugeicons/core-free-icons": "^3.3.0",
    "@hugeicons/react": "^1.1.10",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-separator": "^1.1.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "eventemitter3": "^5.0.4",
    "lucide-react": "^0.562.0",
    "mediabunny": "^1.60.0",
    "motion": "^12.43.0",
    "opencut-wasm": "^0.2.10",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.89.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "react-window": "^2.3.3",
    "sonner": "^1.7.4",
    "soundtouchjs": "^0.3.0",
    "tailwind-merge": "^3.7.0",
    "use-deep-compare-effect": "^1.8.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/culori": "^4.0.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "terser": "^5.49.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.recall.app",
    "productName": "Recall",
    "icon": "build/icon.ico",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../api/dist/recall-engine",
        "to": "recall-engine"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
